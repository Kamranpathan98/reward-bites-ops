{
  "name": "rewardbite",
  "version": "0.1.0",
  "private": true,
  "description": "RewardBite — Restaurant SaaS Platform (V1 monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "build": "npm run build --workspace=packages/contracts && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "test": "npm run test --workspace=packages/contracts && npm run test --workspace=apps/api && npm run test --workspace=apps/web",
    "test:contracts": "npm run test --workspace=packages/contracts",
    "test:api": "npm run test --workspace=apps/api",
    "test:web": "npm run test --workspace=apps/web",
    "test:api:db": "npm run test:db --workspace=apps/api",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "db:init": "node scripts/db-init.mjs",
    "db:migrate": "flyway -configFiles=db/flyway.conf migrate",
    "db:migrate:info": "flyway -configFiles=db/flyway.conf info",
    "db:rls-coverage": "node scripts/rls-coverage-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.12.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
